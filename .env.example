# Copy to .env for local development. Never commit real credentials.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
PORT=3000
NODE_ENV=development

# Set to the exact number of reverse-proxy hops used by your hosting platform.
# Keep 0 when the Node server is directly exposed; do not guess.
TRUST_PROXY_HOPS=0

# Optional for local/private use. Required when NODE_ENV=production.
# Use a unique password (12+ chars) and random secret (32+ chars).
NEXUS_ACCESS_PASSWORD=
NEXUS_SESSION_SECRET=

# Per-process safety caps (resets on process restart; not a billing quota).
NEXUS_MAX_GEMINI_CALLS_PER_MINUTE=12
NEXUS_MAX_GEMINI_CALLS_PER_DAY=120
